@@ -0,0 +1,36 @@
+[package]
+name = "solidcore-cadir"
+description = "CADIR, cadmpeg's neutral CAD model, read into B-rep records: each body's faces, edges and vertices on their curves and surfaces, assembled as the STEP reader assembles its solids"
+edition = "2024"
+license.workspace = true
+version.workspace = true
+publish = false
+
+# solidcore's hard rules (no unsafe, no unwrap/expect/panic, no unchecked indexing), as
+# solidcore-step has them.
+[lints.rust]
+unsafe_code = "forbid"
+
+[lints.clippy]
+unwrap_used = "deny"
+expect_used = "deny"
+panic = "deny"
+indexing_slicing = "deny"
+todo = "deny"
+unimplemented = "deny"
+dbg_macro = "deny"
+neg_cmp_op_on_partial_ord = "allow"
+
+[dependencies]
+# The model read (Apache-2.0); pinned to the release SolidCraft links, whose wire form and
+# conventions this reader was written against.
+cadmpeg-ir = "=0.6.7"
+solidcore = { path = "../solidcore" }
+solidcore-ops = { path = "../solidcore-ops" }
+solidcore-record = { path = "../solidcore-record" }
+solidcore-step = { path = "../solidcore-step" }
+
+# cadmpeg's own example models (a unit cube) as test input.
+[dev-dependencies]
+cadmpeg-ir = { version = "=0.6.7", features = ["examples"] }
+serde_json = "1"
diff --git a/solidcore/crates/solidcore-cadir/src/geometry.rs b/solidcore/crates/solidcore-cadir/src/geometry.rs
new file mode 100644
index 000000000..b51c93a0a
--- /dev/null
+++ b/solidcore/crates/solidcore-cadir/src/geometry.rs
@@ -0,0 +1,471 @@
+//! CADIR's curve and surface carriers as record curves and surfaces.
+//!
+//! A curve keeps its parameter exactly: an edge's interval on the CADIR carrier is its interval
+//! on the record curve. CADIR's line is `origin + t direction` with a unit direction, its circle
+//! and ellipse are at the angle `t` from the frame's reference direction (the major axis of an
+//! ellipse) about its axis, and a NURBS curve is on its own knots: the record's line through
+//! `origin` and `origin + direction`, and its circle, ellipse and spline, have the same `t`. A
+//! polyline is the degree-one spline on its own sample parameters.
+//!
+//! A surface need not keep its (u, v): the assembly makes every pcurve from the 3D edges. What
+//! a surface must keep is its side, so each comes back with whether the record's natural normal
+//! is opposite CADIR's (`reversed`), which turns the face's sense against it. CADIR's plane,
+//! cylinder, circular cone, sphere and torus are the record's with the same frame (x the
+//! reference direction, z the axis) and the same formulas, so their natural normals agree, but
+//! for a sphere or torus with a negative (tube) radius, whose points CADIR places on the other
+//! side of the centre (`c + r n` for `r < 0`): the record holds the radius's magnitude and its
+//! normal is the opposite. A NURBS surface's oriented normal is opposite `Pu × Pv` when CADIR says
+//! `normal_reversed`. A procedural carrier is read by the solved form the producer cached.
+//!
+//! A placed carrier (`Transformed`) is its basis mapped by its affine placement, when that is a
+//! rotation and a uniform scale (with a move): frames turn, lengths scale and parameters are
+//! kept. A placement that shears, scales unevenly or mirrors is refused.
+
+use cadmpeg_ir::geometry::{
+    CurveGeometry, SolvedCurveGeometry, SolvedSurfaceGeometry, SurfaceGeometry,
+};
+use cadmpeg_ir::units::OrthonormalFrame3;
+use solidcore::Vec3;
+use solidcore_record::brep::{Curve as BCurve, Frame, Surface as BSurface};
+use solidcore_step::assembly::{spline_curve, spline_surface};
+
+/// A reason a carrier is not read.
+pub(crate) type R<T> = Result<T, String>;
+
+/// Deepest chain of placed carriers followed (CADIR caps its own nesting too).
+const MAX_PLACEMENTS: usize = 16;
+/// How far a placement's columns may be from one length and from square to each other, relative
+/// to their length, for it to be taken as a rotation and a uniform scale.
+const SIMILARITY: f64 = 1e-9;
+
+fn unsupported(what: impl std::fmt::Display) -> String {
+    format!("not supported yet: {what}")
+}
+
+fn v(p: [f64; 3]) -> Vec3 {
+    Vec3::new(p[0], p[1], p[2])
+}
+
+fn a(p: Vec3) -> [f64; 3] {
+    [p.x, p.y, p.z]
+}
+
+fn point(p: cadmpeg_ir::math::Point3) -> [f64; 3] {
+    [p.x, p.y, p.z]
+}
+
+fn unit(u: &cadmpeg_ir::units::UnitVector3) -> Vec3 {
+    let r = u.as_raw();
+    Vec3::new(r.x, r.y, r.z)
+}
+
+/// The record frame of a CADIR frame at `origin`: x its reference direction, z its axis.
+fn frame(origin: [f64; 3], f: &OrthonormalFrame3) -> Frame {
+    let (z, x) = (unit(f.axis()), unit(f.reference()));
+    Frame {
+        origin,
+        x_axis: a(x),
+        y_axis: a(z.cross(x)),
+    }
+}
+
+/// A rotation, a uniform scale and a move: `p ↦ s Q p + t`, from a placement's rows.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Similarity {
+    rows: [[f64; 4]; 3],
+    scale: f64,
+}
+
+impl Similarity {
+    /// The placement `rows` (row i: `x_i' = r_i0 x + r_i1 y + r_i2 z + r_i3`), when it is a
+    /// similarity that keeps handedness; else why not.
+    pub(crate) fn of(rows: [[f64; 4]; 3]) -> R<Similarity> {
+        if rows.iter().flatten().any(|x| !x.is_finite()) {
+            return Err("a placement that is not finite".into());
+        }
+        let [[a00, a01, a02, _], [a10, a11, a12, _], [a20, a21, a22, _]] = rows;
+        let (c0, c1, c2) = (
+            Vec3::new(a00, a10, a20),
+            Vec3::new(a01, a11, a21),
+            Vec3::new(a02, a12, a22),
+        );
+        let scale = c0.length();
+        let near = |x: f64, y: f64| (x - y).abs() <= SIMILARITY * scale.max(f64::MIN_POSITIVE);
+        let square = near(c0.dot(c1) / scale, 0.0)
+            && near(c1.dot(c2) / scale, 0.0)
+            && near(c0.dot(c2) / scale, 0.0);
+        if !(scale > 0.0) || !square || !near(c1.length(), scale) || !near(c2.length(), scale) {
+            return Err(unsupported("a placement that shears or scales unevenly"));
+        }
+        if !(c0.cross(c1).dot(c2) > 0.0) {
+            return Err(unsupported("a placement that mirrors"));
+        }
+        Ok(Similarity { rows, scale })
+    }
+
+    pub(crate) fn point(&self, p: [f64; 3]) -> [f64; 3] {
+        self.rows
+            .map(|r| r[0] * p[0] + r[1] * p[1] + r[2] * p[2] + r[3])
+    }
+
+    /// A vector (a direction times a length): scaled with the placement.
+    fn vector(&self, d: [f64; 3]) -> [f64; 3] {
+        self.rows.map(|r| r[0] * d[0] + r[1] * d[1] + r[2] * d[2])
+    }
+
+    /// A unit direction: turned, still unit.
+    fn direction(&self, d: [f64; 3]) -> [f64; 3] {
+        self.vector(d).map(|x| x / self.scale)
+    }
+
+    fn frame(&self, f: &Frame) -> Frame {
+        Frame {
+            origin: self.point(f.origin),
+            x_axis: self.direction(f.x_axis),
+            y_axis: self.direction(f.y_axis),
+        }
+    }
+
+    fn curve(&self, c: BCurve) -> R<BCurve> {
+        let s = self.scale;
+        Ok(match c {
+            // The direction is scaled with the line, so `t` stays where it was.
+            BCurve::Line { start, end } => {
+                let d = self.vector([end[0] - start[0], end[1] - start[1], end[2] - start[2]]);
+                let start = self.point(start);
+                BCurve::Line {
+                    start,
+                    end: [start[0] + d[0], start[1] + d[1], start[2] + d[2]],
+                }
+            }
+            BCurve::Circle { frame, radius } => BCurve::Circle {
+                frame: self.frame(&frame),
+                radius: radius * s,
+            },
+            BCurve::Ellipse { frame, radii } => BCurve::Ellipse {
+                frame: self.frame(&frame),
+                radii: radii.map(|r| r * s),
+            },
+            BCurve::Polyline { points } => BCurve::Polyline {
+                points: points.into_iter().map(|p| self.point(p)).collect(),
+            },
+            BCurve::Spline { knots, points } => BCurve::Spline {
+                knots,
+                points: points.into_iter().map(|p| self.point(p)).collect(),
+            },
+            // A rational spline's weights are kept: an affine map acts on its points alone.
+            BCurve::RationalSpline { knots, homogeneous } => BCurve::RationalSpline {
+                knots,
+                homogeneous: homogeneous
+                    .into_iter()
+                    .map(|h| {
+                        let w = h[3];
+                        let p = self.point([h[0] / w, h[1] / w, h[2] / w]);
+                        [p[0] * w, p[1] * w, p[2] * w, w]
+                    })
+                    .collect(),
+            },
+            BCurve::SurfaceIntersection { .. } => {
+                return Err(unsupported("a placed intersection curve"));
+            }
+        })
+    }
+
+    fn surface(&self, s: BSurface) -> R<BSurface> {
+        let k = self.scale;
+        Ok(match s {
+            BSurface::Plane {
+                origin,
+                u_axis,
+                v_axis,
+            } => BSurface::Plane {
+                origin: self.point(origin),
+                u_axis: self.direction(u_axis),
+                v_axis: self.direction(v_axis),
+            },
+            BSurface::Cylinder { frame, radius } => BSurface::Cylinder {
+                frame: self.frame(&frame),
+                radius: radius * k,
+            },
+            BSurface::Cone {
+                frame,
+                radius_at_origin,
+                half_angle,
+            } => BSurface::Cone {
+                frame: self.frame(&frame),
+                radius_at_origin: radius_at_origin * k,
+                half_angle,
+            },
+            BSurface::Sphere { frame, radius } => BSurface::Sphere {
+                frame: self.frame(&frame),
+                radius: radius * k,
+            },
+            BSurface::Torus {
+                frame,
+                major_radius,
+                minor_radius,
+                tube_start,
+            } => BSurface::Torus {
+                frame: self.frame(&frame),
+                major_radius: major_radius * k,
+                minor_radius: minor_radius * k,
+                tube_start,
+            },
+            BSurface::Spline {
+                u_knots,
+                v_knots,
+                points,
+            } => BSurface::Spline {
+                u_knots,
+                v_knots,
+                points: points
+                    .into_iter()
+                    .map(|r| r.into_iter().map(|p| self.point(p)).collect())
+                    .collect(),
+            },
+            BSurface::RationalSpline {
+                u_knots,
+                v_knots,
+                homogeneous,
+            } => BSurface::RationalSpline {
+                u_knots,
+                v_knots,
+                homogeneous: homogeneous
+                    .into_iter()
+                    .map(|r| {
+                        r.into_iter()
+                            .map(|h| {
+                                let w = h[3];
+                                let p = self.point([h[0] / w, h[1] / w, h[2] / w]);
+                                [p[0] * w, p[1] * w, p[2] * w, w]
+                            })
+                            .collect()
+                    })
+                    .collect(),
+            },
+            other => return Err(unsupported(format!("a placed {}", surface_kind(&other)))),
+        })
+    }
+}
+
+fn surface_kind(s: &BSurface) -> &'static str {
+    match s {
+        BSurface::Plane { .. } | BSurface::PlaneThrough { .. } => "plane",
+        BSurface::Cylinder { .. } => "cylinder",
+        BSurface::Cone { .. } => "cone",
+        BSurface::Sphere { .. } => "sphere",
+        BSurface::Torus { .. } => "torus",
+        BSurface::BallPatch { .. } => "ball patch",
+        BSurface::Spline { .. } | BSurface::RationalSpline { .. } => "spline surface",
+        BSurface::PlacedRevolution { .. } => "surface of revolution",
+        BSurface::Blend { .. } => "blend surface",
+    }
+}
+
+/// An edge's curve: the record curve with CADIR's parameter, or `None` for a degenerate curve
+/// (an edge collapsed to a point: a pole of the faces it bounds).
+pub(crate) fn curve(g: &CurveGeometry) -> R<Option<BCurve>> {
+    let solved = g
+        .solved()
+        .ok_or_else(|| unsupported("a procedural curve without its solved form"))?;
+    solved_curve(solved, 0)
+}
+
+fn solved_curve(g: &SolvedCurveGeometry, depth: usize) -> R<Option<BCurve>> {
+    Ok(Some(match g {
+        SolvedCurveGeometry::Line(l) => {
+            let (o, d) = (point(l.origin().get()), unit(&l.direction()));
+            BCurve::Line {
+                start: o,
+                end: a(v(o) + d),
+            }
+        }
+        SolvedCurveGeometry::Circle(c) => BCurve::Circle {
+            frame: frame(point(c.center().get()), c.frame()),
+            radius: c.radius().get(),
+        },
+        SolvedCurveGeometry::Ellipse(e) => BCurve::Ellipse {
+            frame: frame(point(e.center().get()), e.frame()),
+            radii: [e.major_radius().get(), e.minor_radius().get()],
+        },
+        SolvedCurveGeometry::Nurbs(n) => {
+            let points: Vec<[f64; 3]> = n
+                .control_points()
+                .into_iter()
+                .map(|p| point(p.get()))
+                .collect();
+            let weights: Option<Vec<f64>> = n
+                .weights()
+                .map(|w| w.into_iter().map(|w| w.get()).collect());
+            spline_curve(
+                n.degree() as usize,
+                n.knots().as_slice().to_vec(),
+                &points,
+                weights.as_deref(),
+            )?
+        }
+        SolvedCurveGeometry::Polyline(p) => {
+            let points: Vec<[f64; 3]> = p.points().map(|q| point(q.get())).collect();
+            let params: Vec<f64> = match p.parameters() {
+                Some(t) => t.map(|t| t.get()).collect(),
+                None => (0..points.len()).map(|i| i as f64).collect(),
+            };
+            if params.len() != points.len()
+                || params.windows(2).any(|w| !matches!(w, [x, y] if x < y))
+            {
+                return Err("a polyline whose parameters do not increase with its points".into());
+            }
+            let (Some(first), Some(last)) = (params.first(), params.last()) else {
+                return Err("an empty polyline".into());
+            };
+            let knots: Vec<f64> = std::iter::once(*first)
+                .chain(params.iter().copied())
+                .chain(std::iter::once(*last))
+                .collect();
+            spline_curve(1, knots, &points, None)?
+        }
+        SolvedCurveGeometry::Degenerate(_) => return Ok(None),
+        SolvedCurveGeometry::Transformed(placed) => {
+            if depth >= MAX_PLACEMENTS {
+                return Err("placed curves nested too deeply".into());
+            }
+            let Some(basis) = solved_curve(placed.basis(), depth + 1)? else {
+                return Ok(None);
+            };
+            Similarity::of(placed.transform().rows3())?.curve(basis)?
+        }
+        SolvedCurveGeometry::Parabola(_) => return Err(unsupported("a parabola")),
+        SolvedCurveGeometry::Hyperbola(_) => return Err(unsupported("a hyperbola")),
+        SolvedCurveGeometry::Composite { .. } => return Err(unsupported("a composite curve")),
+        SolvedCurveGeometry::Unknown { .. } => {
+            return Err(unsupported("a curve of a kind the producer did not state"));
+        }
+    }))
+}
+
+/// A face's surface, and whether the record's natural normal is opposite CADIR's.
+pub(crate) fn surface(g: &SurfaceGeometry) -> R<(BSurface, bool)> {
+    let solved = g
+        .solved()
+        .ok_or_else(|| unsupported("a procedural surface without its solved form"))?;
+    solved_surface(solved, 0)
+}
+
+fn solved_surface(g: &SolvedSurfaceGeometry, depth: usize) -> R<(BSurface, bool)> {
+    Ok(match g {
+        SolvedSurfaceGeometry::Plane(p) => {
+            let f = frame(point(p.origin().get()), p.frame());
+            (
+                BSurface::Plane {
+                    origin: f.origin,
+                    u_axis: f.x_axis,
+                    v_axis: f.y_axis,
+                },
+                false,
+            )
+        }
+        SolvedSurfaceGeometry::Cylinder(c) => (
+            BSurface::Cylinder {
+                frame: frame(point(c.origin().get()), c.frame()),
+                radius: c.radius().get(),
+            },
+            false,
+        ),
+        SolvedSurfaceGeometry::Cone(c) => {
+            if c.ratio().get() != 1.0 {
+                return Err(unsupported("an elliptical cone"));
+            }
+            let (f, radius, half_angle) = (
+                frame(point(c.origin().get()), c.frame()),
+                c.radius().get(),
+                c.half_angle().get(),
+            );
+            if half_angle == 0.0 {
+                // A cone of no angle is the cylinder over its section, in the same (u, v).
+                if !(radius > 0.0) {
+                    return Err(unsupported("a cone of no angle and no radius"));
+                }
+                (BSurface::Cylinder { frame: f, radius }, false)
+            } else {
+                (
+                    BSurface::Cone {
+                        frame: f,
+                        radius_at_origin: radius,
+                        half_angle,
+                    },
+                    false,
+                )
+            }
+        }
+        SolvedSurfaceGeometry::Sphere(s) => {
+            let r = s.radius().get();
+            (
+                BSurface::Sphere {
+                    frame: frame(point(s.center().get()), s.frame()),
+                    radius: r.abs(),
+                },
+                r < 0.0,
+            )
+        }
+        SolvedSurfaceGeometry::Torus(t) => {
+            let minor = t.minor_radius().get();
+            let torus = BSurface::Torus {
+                frame: frame(point(t.center().get()), t.frame()),
+                major_radius: t.major_radius().get(),
+                minor_radius: minor.abs(),
+                tube_start: 0.0,
+            };
+            (torus, minor < 0.0)
+        }
+        SolvedSurfaceGeometry::Nurbs(n) => {
+            let points: Vec<Vec<[f64; 3]>> = n
+                .control_grid()
+                .into_iter()
+                .map(|r| r.into_iter().map(|p| point(p.get())).collect())
+                .collect();
+            let weights: Option<Vec<Vec<f64>>> = n.weights().map(|w| {
+                w.into_iter()
+                    .map(|r| r.into_iter().map(|w| w.get()).collect())
+                    .collect()
+            });
+            let surface = spline_surface(
+                [n.u_degree() as usize, n.v_degree() as usize],
+                [
+                    n.u_knots().as_slice().to_vec(),
+                    n.v_knots().as_slice().to_vec(),
+                ],
+                &points,
+                weights.as_deref(),
+            )?;
+            (surface, n.normal_reversed())
+        }
+        SolvedSurfaceGeometry::Transformed(placed) => {
+            if depth >= MAX_PLACEMENTS {
+                return Err("placed surfaces nested too deeply".into());
+            }
+            let (basis, reversed) = solved_surface(placed.basis(), depth + 1)?;
+            (
+                Similarity::of(placed.transform().rows3())?.surface(basis)?,
+                reversed,
+            )
+        }
+        SolvedSurfaceGeometry::Polygonal(_) => return Err(unsupported("a polygonal surface")),
+        SolvedSurfaceGeometry::Unknown { .. } => {
+            return Err(unsupported(
+                "a surface of a kind the producer did not state",
+            ));
+        }
+    })
+}
+
+/// The rows of CADIR's affine placement, `[[f64; 4]; 3]`.
+trait Rows3 {
+    fn rows3(&self) -> [[f64; 4]; 3];
+}
+
+impl Rows3 for cadmpeg_ir::transform::Transform {
+    fn rows3(&self) -> [[f64; 4]; 3] {
+        let r = self.rows();
+        [r[0], r[1], r[2]]
+    }
+}
diff --git a/solidcore/crates/solidcore-cadir/src/lib.rs b/solidcore/crates/solidcore-cadir/src/lib.rs
new file mode 100644
index 000000000..fa9666560
--- /dev/null
+++ b/solidcore/crates/solidcore-cadir/src/lib.rs
@@ -0,0 +1,378 @@
+//! CADIR, cadmpeg's neutral CAD model, read into B-rep records ([`solidcore_record::brep`]),
+//! schema 4. Each region of a body is one record: its shells' faces on their surfaces, bounded
+//! by loops of edges on their curves between vertices, added to an [`Assembly`] and finished as
+//! the STEP reader finishes its solids (pcurves, seams, tolerances, the canonical order), so a
+//! file read through cadmpeg and the same file written as STEP become the same record.
+//!
+//! Conventions: CADIR's topology is STEP's. A face's sense compares its normal with its
+//! surface's, a coedge's sense compares its traversal with its edge's curve, an edge runs from
+//! its start vertex to its end along its curve, and a loop's coedges are in traversal order, an
+//! outer loop counter-clockwise about the face's normal. The geometry is in millimetres and
+//! radians ([`geometry`] maps each carrier).
+//!
+//! An edge whose curve is degenerate, or that has none, collapses to its vertex (a cone's apex,
+//! a sphere's pole): its uses are left out of their loops, and a loop of nothing else is that
+//! vertex. What cannot be read refuses its body's region, with the reason, and the others are
+//! still read ([`Bodies::failures`]).
+//!
+//! Input is hostile: every id is looked up (a missing one refuses its region), and the faces of
+//! one model and the edges of one loop are capped.
+
+mod geometry;
+
+use std::collections::HashMap;
+
+use cadmpeg_ir::document::CadIr;
+use cadmpeg_ir::topology::{
+    BodyKind, Coedge, Edge, Face, FaceLoops, Loop, LoopBoundary, Sense, Shell,
+};
+use solidcore_ops::pcurve::Trims;
+pub use solidcore_step::assembly::Solid;
+use solidcore_step::assembly::{Assembly, Bound, Kind};
+use solidcore_step::topology::{
+    MAX_FACES, MAX_FILE_FACES, MAX_FIT_TOLERANCE, MAX_LOOP, MIN_TOLERANCE,
+};
+
+use geometry::R;
+
+/// One body region read into a record.
+#[derive(Clone, Debug)]
+pub struct Read {
+    /// The body's id in the model.
+    pub body: String,
+    /// Which of the body's regions this is, in its order.
+    pub region: usize,
+    /// The record; each of its faces' origin is that face's index in the model's faces.
+    pub solid: Solid,
+}
+
+/// A body region that could not be read, and why.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Failure {
+    pub body: String,
+    pub region: usize,
+    pub message: String,
+}
+
+/// Every body region of a model: those read and those refused.
+#[derive(Clone, Debug, Default)]
+pub struct Bodies {
+    pub read: Vec<Read>,
+    pub failures: Vec<Failure>,
+}
+
+/// The model's tolerance for its records: CADIR's linear tolerance, within the range the STEP
+/// reader takes a file's.
+pub fn tolerance(ir: &CadIr) -> f64 {
+    ir.tolerances
+        .linear
+        .get()
+        .clamp(MIN_TOLERANCE, MAX_FIT_TOLERANCE)
+}
+
+/// Every region of every solid or sheet body of `ir`, read into a record. `trims` makes the
+/// pcurves that have no closed form; without it a face with such a use refuses its region. A
+/// wire body has no faces and is not read.
+pub fn read_bodies(ir: &CadIr, trims: Option<&dyn Trims>) -> Bodies {
+    let model = Model::of(ir);
+    let mut out = Bodies::default();
+    let mut budget = MAX_FILE_FACES;
+    for body in &ir.model.bodies {
+        let id = body.id.as_str().to_string();
+        let kind = match body.kind {
+            BodyKind::Solid => Some(Kind::Solid),
+            BodyKind::Sheet | BodyKind::General => Some(Kind::Model),
+            BodyKind::Wire => None,
+        };
+        let Some(kind) = kind else { continue };
+        for (k, region) in body.regions.iter().enumerate() {
+            let name = body.name.clone().unwrap_or_default();
+            match model.region(
+                region.as_str(),
+                kind,
+                name,
+                tolerance(ir),
+                trims,
+                &mut budget,
+            ) {
+                Ok(solid) => out.read.push(Read {
+                    body: id.clone(),
+                    region: k,
+                    solid,
+                }),
+                Err(message) => out.failures.push(Failure {
+                    body: id.clone(),
+                    region: k,
+                    message,
+                }),
+            }
+        }
+    }
+    out
+}
+
+/// The model's arenas by id.
+struct Model<'a> {
+    regions: HashMap<&'a str, &'a cadmpeg_ir::topology::Region>,
+    shells: HashMap<&'a str, &'a Shell>,
+    faces: HashMap<&'a str, (usize, &'a Face)>,
+    loops: HashMap<&'a str, &'a Loop>,
+    coedges: HashMap<&'a str, &'a Coedge>,
+    edges: HashMap<&'a str, &'a Edge>,
+    vertices: HashMap<&'a str, &'a cadmpeg_ir::topology::Vertex>,
+    points: HashMap<&'a str, &'a cadmpeg_ir::topology::Point>,
+    surfaces: HashMap<&'a str, &'a cadmpeg_ir::geometry::Surface>,
+    curves: HashMap<&'a str, &'a cadmpeg_ir::geometry::Curve>,
+}
+
+impl<'a> Model<'a> {
+    fn of(ir: &'a CadIr) -> Model<'a> {
+        let m = &ir.model;
+        Model {
+            regions: m.regions.iter().map(|x| (x.id.as_str(), x)).collect(),
+            shells: m.shells.iter().map(|x| (x.id.as_str(), x)).collect(),
+            faces: m
+                .faces
+                .iter()
+                .enumerate()
+                .map(|(i, x)| (x.id.as_str(), (i, x)))
+                .collect(),
+            loops: m.loops.iter().map(|x| (x.id.as_str(), x)).collect(),
+            coedges: m.coedges.iter().map(|x| (x.id.as_str(), x)).collect(),
+            edges: m.edges.iter().map(|x| (x.id.as_str(), x)).collect(),
+            vertices: m.vertices.iter().map(|x| (x.id.as_str(), x)).collect(),
+            points: m.points.iter().map(|x| (x.id.as_str(), x)).collect(),
+            surfaces: m.surfaces.iter().map(|x| (x.id.as_str(), x)).collect(),
+            curves: m.curves.iter().map(|x| (x.id.as_str(), x)).collect(),
+        }
+    }
+
+    /// Region `id` read into a record of `kind` (a solid's first shell its outer one, the rest
+    /// its voids).
+    fn region(
+        &self,
+        id: &str,
+        kind: Kind,
+        name: String,
+        tol: f64,
+        trims: Option<&dyn Trims>,
+        budget: &mut usize,
+    ) -> R<Solid> {
+        let region = self
+            .regions
+            .get(id)
+            .ok_or_else(|| format!("missing region {id}"))?;
+        let kind = match kind {
+            Kind::Solid if region.shells.len() > 1 => Kind::Voids,
+            k => k,
+        };
+        let mut b = Builder {
+            model: self,
+            asm: Assembly::new(tol, trims),
+            vertices: HashMap::new(),
+            edges: HashMap::new(),
+        };
+        let mut shells = Vec::new();
+        for s in &region.shells {
+            if shells.len() >= solidcore_record::brep::MAX_SHELLS {
+                return Err(format!(
+                    "more than {} shells",
+                    solidcore_record::brep::MAX_SHELLS
+                ));
+            }
+            let shell = self
+                .shells
+                .get(s.as_str())
+                .ok_or_else(|| format!("missing shell {s}"))?;
+            let mut faces = Vec::new();
+            for f in shell.faces() {
+                if faces.len() >= MAX_FACES {
+                    return Err(format!("more than {MAX_FACES} faces"));
+                }
+                *budget = budget
+                    .checked_sub(1)
+                    .ok_or_else(|| format!("more than {MAX_FILE_FACES} faces in one model"))?;
+                faces.push(b.face(f.as_str())?);
+            }
+            shells.push(faces);
+        }
+        b.asm.finish(0, name, shells, kind)
+    }
+}
+
+/// One region being read: the model, and what of it the assembly holds.
+struct Builder<'m, 'a, 't> {
+    model: &'m Model<'a>,
+    asm: Assembly<'t>,
+    /// CADIR vertex → the assembly's.
+    vertices: HashMap<&'a str, u32>,
+    /// CADIR edge → the assembly's edge, or the vertex an edge collapsed to a point is.
+    edges: HashMap<&'a str, Result<u32, u32>>,
+}
+
+impl<'a> Builder<'_, 'a, '_> {
+    fn vertex(&mut self, id: &'a str) -> R<u32> {
+        if let Some(v) = self.vertices.get(id) {
+            return Ok(*v);
+        }
+        let vertex = self
+            .model
+            .vertices
+            .get(id)
+            .ok_or_else(|| format!("missing vertex {id}"))?;
+        let point = self
+            .model
+            .points
+            .get(vertex.point.as_str())
+            .ok_or_else(|| format!("missing point {}", vertex.point))?;
+        let p = point.position().get();
+        let v = self.asm.add_vertex([p.x, p.y, p.z])?;
+        self.vertices.insert(id, v);
+        Ok(v)
+    }
+
+    /// Edge `id` in the assembly, or the vertex it collapses to. The record edge runs along its
+    /// curve; its vertices are the CADIR edge's, at the interval's ends their points are nearer.
+    fn edge(&mut self, id: &'a str, origin: u64) -> R<Result<u32, u32>> {
+        if let Some(e) = self.edges.get(id) {
+            return Ok(*e);
+        }
+        let edge = self
+            .model
+            .edges
+            .get(id)
+            .ok_or_else(|| format!("missing edge {id}"))?;
+        let (start, end) = (
+            self.vertex(edge.start.as_str())?,
+            self.vertex(edge.end.as_str())?,
+        );
+        let curve = match edge.carrier.curve() {
+            Some(c) => {
+                let carrier = self
+                    .model
+                    .curves
+                    .get(c.as_str())
+                    .ok_or_else(|| format!("missing curve {c}"))?;
+                geometry::curve(&carrier.geometry).map_err(|m| format!("edge {id}: {m}"))?
+            }
+            None => None,
+        };
+        let made = match curve {
+            Some(curve) => {
+                let interval = edge.param_range().map(|r| r.get()).ok_or_else(|| {
+                    format!("edge {id}: not supported yet: an edge without a parameter range")
+                })?;
+                Ok(self
+                    .asm
+                    .add_edge(origin, curve, interval, [start, end])
+                    .map_err(|m| format!("edge {id}: {m}"))?
+                    .0)
+            }
+            // Collapsed to a point: its vertices are one.
+            None if start == end || same_point(&self.asm, start, end) => Err(start),
+            None => return Err(format!("edge {id}: no curve between two vertices apart")),
+        };
+        self.edges.insert(id, made);
+        Ok(made)
+    }
+
+    /// Face `id` as its shell uses it: its index in the assembly and its side (always the face's
+    /// own normal: CADIR's shells hold faces as they are).
+    fn face(&mut self, id: &'a str) -> R<(u32, bool)> {
+        let &(index, face) = self
+            .model
+            .faces
+            .get(id)
+            .ok_or_else(|| format!("missing face {id}"))?;
+        let origin = index as u64;
+        let surface = self
+            .model
+            .surfaces
+            .get(face.surface.as_str())
+            .ok_or_else(|| format!("face {id}: missing surface {}", face.surface))?;
+        let (surface, reversed) =
+            geometry::surface(&surface.geometry).map_err(|m| format!("face {id}: {m}"))?;
+        let ids: Vec<&'a cadmpeg_ir::ids::LoopId> = face.loops.iter().collect();
+        if ids.is_empty() {
+            return Err(format!(
+                "face {id}: not supported yet: a face with no boundary"
+            ));
+        }
+        let outer = match &face.loops {
+            FaceLoops::Classified { outer, .. } => ids.iter().position(|l| *l == outer),
+            FaceLoops::Unspecified { .. } => None,
+        };
+        // Bounds relative to the record surface's natural normal.
+        let side = (face.sense == Sense::Forward) != reversed;
+        let mut bounds = Vec::new();
+        for l in ids {
+            let mut bound = self
+                .bound(l.as_str(), origin)
+                .map_err(|m| format!("face {id}: {m}"))?;
+            if !side && let Bound::Edges(uses) = &mut bound {
+                uses.reverse();
+                for u in uses.iter_mut() {
+                    u.1 = !u.1;
+                }
+            }
+            bounds.push(bound);
+        }
+        Ok((
+            self.asm.add_face(origin, surface, bounds, outer, side)?,
+            side,
+        ))
+    }
+
+    /// Loop `id`: its coedges as edge uses in traversal order, those of collapsed edges left
+    /// out; a loop of nothing else (or a vertex loop) is its vertex.
+    fn bound(&mut self, id: &'a str, origin: u64) -> R<Bound> {
+        let lp = self
+            .model
+            .loops
+            .get(id)
+            .ok_or_else(|| format!("missing loop {id}"))?;
+        let ring = match &lp.boundary {
+            LoopBoundary::Vertex { vertex, .. } => {
+                return Ok(Bound::Vertex(self.vertex(vertex.as_str())?));
+            }
+            LoopBoundary::Ring(ring) => ring.coedges(),
+        };
+        if ring.len() > MAX_LOOP {
+            return Err(format!("a loop of {} edges", ring.len()));
+        }
+        let mut uses = Vec::new();
+        let mut pole = None;
+        for c in ring {
+            let coedge = self
+                .model
+                .coedges
+                .get(c.as_str())
+                .ok_or_else(|| format!("missing coedge {c}"))?;
+            match self.edge(coedge.edge.as_str(), origin)? {
+                // A coedge's sense is against its edge's curve, which the record edge runs along
+                // whichever of its vertices the producer called its start.
+                Ok(e) => uses.push((e, coedge.sense == Sense::Forward)),
+                Err(v) => pole = Some(v),
+            }
+        }
+        match (uses.is_empty(), pole) {
+            (false, _) => Ok(Bound::Edges(uses)),
+            (true, Some(v)) => Ok(Bound::Vertex(v)),
+            (true, None) => Err(format!("loop {id} has no edges")),
+        }
+    }
+}
+
+/// Two of the assembly's vertices at one point to within its tolerance.
+fn same_point(asm: &Assembly<'_>, a: u32, b: u32) -> bool {
+    match (asm.vertex_point(a), asm.vertex_point(b)) {
+        (Some(p), Some(q)) => {
+            let d = [p[0] - q[0], p[1] - q[1], p[2] - q[2]];
