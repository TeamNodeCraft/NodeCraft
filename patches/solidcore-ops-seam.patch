+/// Run `f` with every ops call on this thread using `kernel` instead of the process kernel.
+pub fn with_kernel<R>(kernel: &mut Kernel, f: impl FnOnce() -> R) -> R {
+    NEEDS_RESET.store(false, Ordering::Relaxed);
+    let owned = std::mem::replace(kernel, Kernel::new(&KernelOptions::default()));
+    let cell = std::cell::RefCell::new(Some(owned));
+    let value = BORROWED.set(&cell, f);
+    *kernel = cell.into_inner().unwrap_or_else(|| Kernel::new(&KernelOptions::default()));
+    value
+}
+
+/// Whether the last borrowed-kernel call left the kernel needing a rebuild.
+#[must_use]
+pub fn kernel_needs_reset() -> bool {
+    NEEDS_RESET.load(Ordering::Relaxed)
+}
