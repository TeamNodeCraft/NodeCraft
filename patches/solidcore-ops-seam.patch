From 865c085cd5938156801fa447689c8087db146ade Mon Sep 17 00:00:00 2001
From: AlexMitchellMus <12004932+AlexMitchellMus@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:59:41 +1030
Subject: [PATCH 11/12] ops: a lent kernel's own cancelled token stops the call
 before it runs

The borrowed path joined the application's token with the lent kernel's
token for the kernel's own checks, but decided 'cancelled before' and
'stopped' from the application's token alone. A call that reaches no kernel
check, such as a round between planes built in closed form, ran to the end
on a lent kernel whose token was cancelled. One joined token now decides
all three.
---
 solidcore/crates/solidcore-ops/src/session.rs | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/solidcore/crates/solidcore-ops/src/session.rs b/solidcore/crates/solidcore-ops/src/session.rs
index 019282daed..b1208a999e 100644
--- a/solidcore/crates/solidcore-ops/src/session.rs
+++ b/solidcore/crates/solidcore-ops/src/session.rs
@@ -609,16 +609,20 @@ fn run_borrowed<T: Answer>(
             IN_CALL.with(|d| d.set(d.get().saturating_sub(1)));
         }
     }
-    let token = crate::cancel::current();
-    if token.as_ref().is_some_and(CancelToken::is_cancelled) {
-        return Err(Error::Cancelled);
-    }
-    let saved_cancel = k.cancel.take();
-    k.cancel = match (token.as_ref(), saved_cancel.as_ref()) {
+    // The call stops on either token, the application's or the lent kernel's own: one joined
+    // token decides it before the call, while it runs, and after it, so a call that reaches no
+    // kernel check (a closed-form round) is still stopped by the lent kernel's token.
+    let ops_token = crate::cancel::current();
+    let token = match (ops_token.as_ref(), k.cancel.as_ref()) {
         (Some(t), Some(s)) => Some(t.either(s)),
         (Some(t), None) => Some(t.clone()),
         (None, s) => s.cloned(),
     };
+    if token.as_ref().is_some_and(CancelToken::is_cancelled) {
+        return Err(Error::Cancelled);
+    }
+    let saved_cancel = k.cancel.take();
+    k.cancel.clone_from(&token);
     CURRENT.with(|c| c.set(Some(call)));
     IN_CALL.with(|d| d.set(d.get() + 1));
     let depth = Depth;
