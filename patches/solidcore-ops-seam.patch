+#[test]
+fn borrowed_kernel_matches_the_global_path() {
+    use solidcore::kernel::{Kernel, KernelOptions, UpstreamFixes};
+    use solidcore_ops::session::{kernel_needs_reset, with_kernel};
+    all_fixes();
+    let mut global = block();
+    let edge = top_front(&global);
+    blend(&mut global, Blend::Round, &[edge], &[2.0], &[], Corners::Filled).unwrap();
+    let global_volume = volume(&global);
+    let source = block();
+    let brep = source.into_brep();
+    let order = Order::of(&brep);
+    let mut kernel = Kernel::new(&KernelOptions::default());
+    kernel.fixes = UpstreamFixes::all();
+    let mut borrowed = Body::from_brep(&mut kernel, brep).unwrap();
+    let edge = top_front(&borrowed);
+    with_kernel(&mut kernel, || {
+        solidcore_ops::blend_ordered(&borrowed, &order, Blend::Round, &[edge], &[2.0], &[], Corners::Filled, BlendOptions::default())
+    }).expect("borrowed blend");
+    assert!(rel(volume(&borrowed), global_volume) < 1.0e-9);
+    assert!(!kernel_needs_reset());
