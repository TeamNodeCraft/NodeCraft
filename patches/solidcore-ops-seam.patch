+fn run_borrowed<T: Answer>(
+    call: &'static str,
+    inputs: Inputs<'_>,
+    before: bool,
+    f: impl FnOnce(&mut Kernel) -> solidcore::Result<T>,
+    k: &mut Kernel,
+) -> Result<T> {
+    struct Depth;
+    impl Drop for Depth {
+        fn drop(&mut self) { IN_CALL.with(|d| d.set(d.get().saturating_sub(1))); }
+    }
+    let token = crate::cancel::current();
+    if token.as_ref().is_some_and(CancelToken::is_cancelled) {
+        return Err(Error::Cancelled);
+    }
+    if let Some(token) = token.as_ref() {
+        let previous = k.cancel.clone().unwrap_or_else(CancelToken::new);
+        k.cancel = Some(token.either(&previous));
+    }
+    set_current(Some(call));
+    IN_CALL.with(|d| d.set(d.get() + 1));
+    let depth = Depth;
+    let hook = HOOK.lock().unwrap_or_else(PoisonError::into_inner).clone();
+    let snapshot = (before && hook.is_some()).then(|| written(k, inputs));
+    STOPPED.with(|d| d.set(None));
+    let caught = catch_unwind(AssertUnwindSafe(|| f(k)));
+    let stopped = STOPPED.with(Cell::take).unwrap_or_else(|| token.as_ref().is_some_and(CancelToken::is_cancelled));
+    let r = match caught {
+        Ok(_) if stopped => { NEEDS_RESET.store(true, Ordering::Relaxed); Err(Error::Cancelled) }
+        Ok(Ok(v)) => Ok(v),
+        Ok(Err(e)) => Err(status(e)),
+        Err(p) => { NEEDS_RESET.store(true, Ordering::Relaxed); Err(Error::Internal(format!("{call}: {}", message(p.as_ref())))) }
+    };
+    k.cancel = None;
+    set_current(None);
+    let why = match &r { Err(Error::Cancelled) => None, Ok(v) => v.refusal(), Err(e) => Some(e.to_string()) };
+    let report = why.and_then(|why| { let hook = hook?; let inputs = match snapshot { Some(taken) => taken, None => written(k, inputs) }; Some((hook, why, inputs)) });
+    drop(depth);
+    if let Some((hook, why, inputs)) = report {
+        let failure = Failure { call, why: &why, inputs };
+        catch_unwind(AssertUnwindSafe(|| hook(&failure))).ok();
+    }
+    r
+}
