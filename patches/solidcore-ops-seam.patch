+
+#[test]
+fn an_edge_whose_vertices_are_written_the_other_way_round_is_turned_and_noted() {
+    let mut ir = cube();
+    let edge = ir.model.edges.first_mut().unwrap();
+    std::mem::swap(&mut edge.start, &mut edge.end);
+    let s = one(&ir);
+    assert!(
